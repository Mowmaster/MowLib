{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "mowlib:filter_mode",
    "cases": [
      {
        "when": "mowlib:items",
        "model": {
          "type": "minecraft:model",
          "model": "mowlib:item/filters/filter_enchantedexact_items",
          "tints": [
            {
              "type": "minecraft:constant",
              "value": -1
            },
            {
              "type": "mowlib:filter_list"
            }
          ]
        }
      },
      {
        "when": "mowlib:fluids",
        "model": {
          "type": "minecraft:model",
          "model": "mowlib:item/filters/filter_enchantedexact_fluids",
          "tints": [
            {
              "type": "minecraft:constant",
              "value": -1
            },
            {
              "type": "mowlib:filter_list"
            }
          ]
        }
      },
      {
        "when": "mowlib:energy",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "mowlib:filter_blacklist",
          "entries": [
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "mowlib:item/filters/filter_disabled_energy",
                "tints": [
                  {
                    "type": "minecraft:constant",
                    "value": -1
                  },
                  {
                    "type": "mowlib:filter_list"
                  }
                ]
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mowlib:item/filters/filter_enchantedexact_energy",
            "tints": [
              {
                "type": "minecraft:constant",
                "value": -1
              },
              {
                "type": "mowlib:filter_list"
              }
            ]
          }
        }
      },
      {
        "when": "mowlib:experience",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "mowlib:filter_blacklist",
          "entries": [
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "mowlib:item/filters/filter_disabled_experience",
                "tints": [
                  {
                    "type": "minecraft:constant",
                    "value": -1
                  },
                  {
                    "type": "mowlib:filter_list"
                  }
                ]
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mowlib:item/filters/filter_enchantedexact_experience",
            "tints": [
              {
                "type": "minecraft:constant",
                "value": -1
              },
              {
                "type": "mowlib:filter_list"
              }
            ]
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "mowlib:item/filters/filter_enchantedexact",
      "tints": [
        {
          "type": "minecraft:constant",
          "value": -1
        },
        {
          "type": "mowlib:filter_list"
        }
      ]
    }
  }
}
